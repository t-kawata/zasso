{
  "enabledPlugins": {
    "darvium@darvium-marketplace": false,
    "ecc-mycute@ecc-mycute-marketplace": false,
    "context-mode@context-mode": true
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/scripts/grill-me-for-rfc/guard-obligation-on-commit.js"
          }
        ]
      }
    ]
  }
}
