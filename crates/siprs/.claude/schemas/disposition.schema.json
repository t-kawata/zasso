{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "conver://schemas/disposition.schema.json",
  "title": "Clause disposition",
  "type": "object",
  "required": ["version", "key", "status"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "key": { "type": "string", "pattern": "^clause\\|" },
    "status": {
      "type": "string",
      "enum": [
        "TESTABLE",
        "DESIGN_PREDICATE_VERIFIED",
        "PROCESS_VERIFIED",
        "EXTERNAL_VERIFIED",
        "NOT_APPLICABLE_VERIFIED",
        "DEFERRED"
      ]
    },
    "ruleId": { "type": "string", "minLength": 1 },
    "normativeSource": { "type": "string", "minLength": 1 },
    "predicate": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "evidenceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "createdAt": { "type": "string", "format": "date" },
    "expiresAt": { "type": "string", "format": "date" }
  },
  "oneOf": [
    {
      "properties": { "status": { "const": "TESTABLE" } }
    },
    {
      "properties": { "status": { "const": "DESIGN_PREDICATE_VERIFIED" } },
      "required": ["ruleId", "normativeSource", "predicate", "command", "evidence", "evidenceDigest"]
    },
    {
      "properties": { "status": { "const": "PROCESS_VERIFIED" } },
      "required": ["ruleId", "normativeSource", "command", "evidence", "evidenceDigest"]
    },
    {
      "properties": { "status": { "const": "EXTERNAL_VERIFIED" } },
      "required": ["ruleId", "normativeSource", "owner", "reason", "command", "evidence", "evidenceDigest"]
    },
    {
      "properties": { "status": { "const": "NOT_APPLICABLE_VERIFIED" } },
      "required": ["ruleId", "normativeSource", "evidence", "evidenceDigest"]
    },
    {
      "properties": { "status": { "const": "DEFERRED" } },
      "required": ["owner", "reason", "normativeSource", "createdAt", "expiresAt"]
    }
  ]
}
