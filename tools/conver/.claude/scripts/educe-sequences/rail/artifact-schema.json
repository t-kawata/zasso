{
  "schema_version": 2,
  "schema_versions": [2, 3],
  "artifact_suffix": "-sequences",
  "artifact_extension": ".json",
  "render_extension": ".md",
  "vocabulary": {
    "optional": true,
    "actPatterns": {
      "type": "array",
      "items": "string",
      "optional": true
    }
  },
  "required": [
    "schema_version",
    "spec",
    "pins",
    "sequences",
    "steps",
    "operations",
    "adjudications",
    "sections",
    "exemptions",
    "verify"
  ],
  "spec": {
    "required": ["path", "sha256", "lines"]
  },
  "pins": {
    "required": ["predicate", "rowSchema", "enumerations", "forms", "sectionLevel", "blocks"],
    "predicate": { "required": ["line", "limbs"] },
    "rowSchema": { "required": ["line", "fields"] },
    "enumerations": { "required": ["name", "members", "ranges", "closedness"] },
    "forms": { "required": ["name", "proposes"] },
    "sourceEnumerations": { "required": ["name", "role", "source", "members"], "kinds": ["censusPin", "materialDeclaration"], "coordinates": ["specSpans"], "source": { "required": ["file", "sha256"] }, "selector": { "required": ["shape", "parameter"] } },
    "columns": { "required": ["name", "decidedBy"] },
    "blocks": { "required": ["id", "firstLine", "lastLine"] }
  },
  "outcomes": ["direct", "viaNeighbour", "notASequence", "singleStep", "exempt"],
  "positions": ["positioned", "singleStep", "suppliedRule", "excluded"],
  "escapes": ["suppliedRule", "excluded"],

  "adjudications": {
    "required": ["subject", "outcome", "reader"]
  },
  "predicateRulings": {
    "outcomes": ["notASequence"],
    "field": "predicateLimb",
    "noLimbApplies": "none-applies"
  },
  "sequences": {
    "required": ["id", "kind", "firstLine", "lastLine"],
    "crossRefs": { "required": ["line", "note"] }
  },
  "steps": {
    "required": ["id", "sequence", "operation", "line", "quote"],
    "v3Required": ["contract"],
    "contract": {
      "required": ["pre", "post", "invariants", "consumes", "produces", "errors", "crosses"],
      "fact": { "required": ["factId", "text", "source"] }
    }
  },
  "operations": {
    "v3Required": ["registry_contribution"],
    "registryContribution": { "values": ["required", "not_required"], "groundRequiredFor": ["not_required"] },
    "boundaryEffects": { "required": ["boundary", "direction"] }
  },
  "verify": { "required": ["command", "expected_exit"] }
}
