{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspacify.invalid/schemas/workspacify-tree-decisions.schema.json",
  "title": "WORKSPACIFY-TREE-DECISIONS",
  "type": "object",
  "required": ["workspace", "ownership", "dependencies", "adapters", "approvals"],
  "properties": {
    "workspace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "path", "layer", "kind"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "layer": { "type": "string" },
          "kind": { "type": "string" },
          "owns": {
            "type": "object",
            "properties": {
              "objects": { "type": "array", "items": { "type": "string" } },
              "claims": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "ownership": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["objectId", "packageId"],
        "properties": {
          "objectId": { "type": "string" },
          "packageId": { "type": "string" }
        }
      }
    },
    "dependencies": { "type": "array", "items": { "type": "object" } },
    "adapters": {},
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decisionId", "rationale", "approver"],
        "properties": {
          "decisionId": { "type": "string" },
          "rationale": { "type": "string" },
          "approver": { "type": "string" }
        }
      }
    }
  }
}
