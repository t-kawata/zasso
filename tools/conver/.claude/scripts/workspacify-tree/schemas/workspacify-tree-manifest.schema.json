{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspacify.invalid/schemas/workspacify-tree-manifest.schema.json",
  "title": "WORKSPACIFY-TREE-MANIFEST",
  "type": "object",
  "required": [
    "$schema",
    "artifact_kind",
    "schema_version",
    "status",
    "run",
    "input",
    "structure",
    "inventory",
    "requirements",
    "workspace",
    "adapters",
    "dependencies",
    "conformance",
    "stage2_handoff",
    "gates",
    "final_audit",
    "integrity"
  ],
  "properties": {
    "$schema": { "type": "string", "const": "https://json-schema.org/draft/2020-12/schema" },
    "artifact_kind": { "type": "string", "const": "workspacify-tree-manifest" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "status": { "type": "string", "enum": ["COMPLETE", "FAIL", "REVIEW_REQUIRED", "BLOCKED"] },
    "run": { "type": "object" },
    "input": { "type": "object" },
    "structure": { "type": "object" },
    "inventory": { "type": "object" },
    "requirements": { "type": "object" },
    "workspace": { "type": "object" },
    "adapters": { "type": "object" },
    "dependencies": { "type": "object" },
    "conformance": { "type": "object" },
    "stage2_handoff": { "type": "object" },
    "gates": { "type": "object" },
    "final_audit": { "type": "object" },
    "integrity": { "type": "object" }
  }
}
