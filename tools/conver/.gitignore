# deploy の TARGET パスにチルダがリテラル解釈された場合のゴミを無視
~/

# Rust build artefacts produced while verifying the scrubbed experiment input
siprs-for-reverse/target/

# A record of this machine's resolved versions. Committing it would state one
# machine's answer as if it were everyone's, so it is produced but not tracked.
ENV-MANIFEST.json

# What the installer installed last time. It describes this working copy only.
.claude/.conver-install-state.json

# Holdout projects generality is measured against. They are working material
# reproduced from the commit each candidate declares, not source this project
# owns: the ledger freezes their digest, and committing the trees would put tens
# of thousands of upstream files under this repository's review.
tests/workspacify-reverse/holdout/corpus/
