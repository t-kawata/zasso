{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "zasso://schemas/malfeasance.json",
  "type": "object",
  "required": ["version", "records"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "スキーマバージョン。将来の拡張に備える。"
    },
    "records": {
      "type": "array",
      "description": "犯罪レコードの配列",
      "items": { "$ref": "#/definitions/record" }
    }
  },
  "definitions": {
    "record": {
      "type": "object",
      "required": ["id", "file", "line", "description", "detected_at", "status"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "description": "自動採番される一意の識別子"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "犯罪コードが存在するファイルの相対パス"
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "犯罪コードの開始行番号"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "犯罪の内容説明"
        },
        "detected_at": {
          "type": "string",
          "format": "date-time",
          "description": "検出日時（ISO 8601）"
        },
        "status": {
          "type": "string",
          "enum": ["open", "resolved", "false_positive"],
          "description": "犯罪の状態"
        },
        "resolved_at": {
          "type": "string",
          "format": "date-time",
          "description": "解決日時（status=resolved 時に必須）"
        },
        "resolved_by_ticket": {
          "type": "integer",
          "minimum": 1,
          "description": "解決したチケットID"
        },
        "note": {
          "type": "string",
          "description": "備考"
        }
      }
    }
  }
}
