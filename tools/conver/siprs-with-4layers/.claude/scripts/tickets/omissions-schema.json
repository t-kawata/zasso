{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "zasso://schemas/omissions.json",
  "type": "object",
  "required": ["parentRfcPath", "generatedAt", "omissions"],
  "properties": {
    "parentRfcPath": { "type": "string", "minLength": 1 },
    "parentRfcTitle": { "type": "string" },
    "generatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "summary": { "type": "string" },
    "rfcUnderstanding": {
      "type": "object",
      "properties": {
        "purpose": { "type": "string" },
        "goals": { "type": "string" },
        "successCriteria": { "type": "string" },
        "nonScope": { "type": "string" },
        "architecture": { "type": "string" },
        "componentRelations": { "type": "string" },
        "designDecisions": { "type": "string" },
        "typeDefinitions": { "type": "string" },
        "apiSignatures": { "type": "string" },
        "dependencyGraph": { "type": "string" },
        "externalDependencies": { "type": "string" },
        "testRequirements": { "type": "string" },
        "errorHandling": { "type": "string" },
        "configuration": { "type": "string" }
      }
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/definitions/step" }
    },
    "omissions": {
      "type": "array",
      "items": { "$ref": "#/definitions/omission" }
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "required": ["id", "label", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["todo", "in_progress", "done"] },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/step" }
        }
      }
    },
    "omission": {
      "type": "object",
      "required": ["id", "type", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^O-\\d{3}$" },
        "type": {
          "type": "string",
          "enum": [
            "missing_implementation",
            "incomplete_implementation",
            "design_deviation",
            "bug",
            "stub_remaining",
            "test_missing",
            "inconsistency"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"]
        },
        "rfcSection": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "details": { "type": "string" },
        "affectedFiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "suggestedResolution": { "type": "string" },
        "resolvedInNextRfc": { "type": "boolean" }
      }
    }
  }
}
